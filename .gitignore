# Course material from DataScientest; condensed in references/
course-material/

# Team notes and guides kept on this machine only
internal/

# Python environment created by uv
.venv/

# Local settings and passwords
.env

# Trained models and dataset copies; the empty folders are kept, so Docker never
# has to create them (as root).
models/*
!models/.gitkeep
datasets/*
!datasets/.gitkeep

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# Documents are kept as Markdown; PDF exports stay local
*.pdf

# Price data stays private, never committed
*.csv
