# Copy to .env, which is never committed. The development login admin/admin is for a
# local database only; set a real password on any shared host.
POSTGRES_DB=forecasting
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Folder for trained models (gitignored).
MODEL_DIR=models

# Minutes after an exchange's close from which a fetched price is final.
FINAL_DELAY_MINUTES=20

# Your own free EODHD key (eodhd.com); every member uses their own.
EODHD_API_KEY=
