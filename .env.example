# Copy to .env, which is never committed. The development passwords below are for
# local use only.
POSTGRES_DB=forecasting
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Port of the Airflow page on this machine (http://localhost:<port>).
AIRFLOW_PORT=8080

# Password of the Airflow page's login, user admin.
AIRFLOW_ADMIN_PASSWORD=admin

# Password of Airflow's own database login; letters and digits only, since it becomes
# part of a connection address.
AIRFLOW_DB_PASSWORD=airflow

# Secret Airflow signs its internal tokens with; any long random text.
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-text

# Port of the MLflow page on this machine (http://localhost:<port>).
MLFLOW_PORT=5000
#http://host.docker.internal:5000
##CHANGED!!!????

# Password of MLflow's own database login; letters and digits only, since it becomes
# part of a connection address.
MLFLOW_DB_PASSWORD=mlflow

# Login of the object store that holds MLflow's model files and DVC's dataset copies.
OBJECT_STORE_USER=admin
OBJECT_STORE_PASSWORD=admin

# Simulated today of the first replay run: every stored day up to it is copied at once
# into the replay database, named after POSTGRES_DB with _replay.
REPLAY_START=2026-06-01

# Seconds from the start of one replayed day to the next. The replay pipeline refuses
# a value outside its limits; the Airflow page names them.
REPLAY_INTERVAL_SECONDS=60

# Folder for trained models (gitignored).
MODEL_DIR=models

# Minutes after an exchange's close from which a fetched price is final; 25 to 60.
# Below 25 a price from before the close can count as final (EODHD lags about 15
# minutes, and Xetra's closing auction ends about 6 minutes after its close); above 60
# a day's close stays provisional longer for no gain. Raising it can make the latest
# stored day provisional again; the next load then replaces it.
FINAL_DELAY_MINUTES=25

# First day of price history loaded for a security with none stored; 1980-01-02 at
# the earliest.
HISTORY_START=1980-01-02

# Your own free EODHD key (eodhd.com); every member uses their own.
EODHD_API_KEY=6ae09095ee6225.61162452
