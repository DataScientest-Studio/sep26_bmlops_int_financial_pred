{
  "uid": "api",
  "title": "API",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (handler) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Response time that 95% of requests stay under",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (handler, le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate",
      "description": "Share of requests the API answered with a server error (5xx).",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "api:error_ratio:rate5m",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Trading days behind",
      "description": "Trading days after the latest stored day that were final when the security's latest load ran.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "trading_days_behind",
          "instant": true,
          "legendFormat": "{{symbol}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Drift",
      "description": "The latest finished feature drift and prediction drift check of each security: whether it found drift, and its p-value.",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Feature drift" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "no", "color": "green" },
                      "1": { "text": "yes", "color": "red" }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Prediction drift" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "no", "color": "green" },
                      "1": { "text": "yes", "color": "red" }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Feature p-value" },
            "properties": [{ "id": "decimals", "value": 6 }]
          },
          {
            "matcher": { "id": "byName", "options": "Prediction p-value" },
            "properties": [{ "id": "decimals", "value": 6 }]
          }
        ]
      },
      "transformations": [
        { "id": "joinByField", "options": { "byField": "symbol", "mode": "outerTabular" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true
            },
            "indexByName": {
              "symbol": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "symbol": "Security",
              "Value #A": "Feature drift",
              "Value #B": "Feature p-value",
              "Value #C": "Prediction drift",
              "Value #D": "Prediction p-value"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "max by (symbol) (drift_found{drift_kind=\"feature\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (symbol) (drift_p_value{drift_kind=\"feature\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "max by (symbol) (drift_found{drift_kind=\"prediction\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "max by (symbol) (drift_p_value{drift_kind=\"prediction\"})",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}
